# =============================================================================
# .env.example — Template for required environment variables
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit your .env file — it contains secrets!
#      (It is already in .gitignore)
#
# The application loads this file automatically via python-dotenv.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Credentials
# -----------------------------------------------------------------------------
#
# Option A: Explicit keys (good for local development)
#   Set your IAM user's Access Key ID and Secret Access Key below.
#
# Option B: AWS Profile (recommended for developers)
#   If you have `~/.aws/credentials` configured (via `aws configure`),
#   you can leave these blank and set AWS_PROFILE instead:
#   AWS_PROFILE=my-profile-name
#
# Option C: IAM Role (best for CI/CD and EC2/ECS deployments)
#   If running on an AWS service with an attached IAM role,
#   leave all credential fields blank — boto3 picks them up automatically.
#
# Required IAM permissions for Bedrock:
#   - bedrock:InvokeModel
#   - bedrock:InvokeModelWithResponseStream
#
# See: https://docs.aws.amazon.com/bedrock/latest/userguide/getting-started.html
#
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# The AWS region where you have AWS Bedrock enabled.
# Bedrock is NOT available in all regions — check the AWS console.
# Common choices: us-east-1, us-west-2, eu-west-1, ap-southeast-1
AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Bedrock Model Selection
# -----------------------------------------------------------------------------
#
# Format: bedrock/<model-id-from-aws-console>
#
# The "bedrock/" prefix tells LiteLLM to route this request through AWS Bedrock.
# The model ID after the slash must exactly match the Model ID shown in the
# AWS Bedrock console under "Model access".
#
# ⚠️  IMPORTANT: You must first enable model access in your AWS account!
#     Console → Amazon Bedrock → Model access → Request access
#
# Recommended Models (balance of quality and cost):
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ PROVIDER    │ MODEL ID                                          │ NOTES  │
# ├─────────────┼───────────────────────────────────────────────────┼────────┤
# │ Anthropic   │ anthropic.claude-3-5-sonnet-20241022-v2:0         │ Best ✓ │
# │ Anthropic   │ anthropic.claude-3-5-haiku-20241022-v1:0          │ Fast   │
# │ Anthropic   │ anthropic.claude-3-opus-20240229-v1:0             │ Expensive │
# │ Amazon      │ amazon.nova-pro-v1:0                              │ Cheap  │
# │ Amazon      │ amazon.nova-lite-v1:0                             │ Cheapest │
# │ Meta        │ meta.llama3-70b-instruct-v1:0                     │ Open   │
# │ Mistral     │ mistral.mistral-large-2402-v1:0                   │ Good   │
# └──────────────────────────────────────────────────────────────────────────┘
#
# Default uses Claude 3.5 Sonnet v2 — excellent reasoning for research tasks.
#
BEDROCK_MODEL_ID=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: Override temperature (0.0 = deterministic, 1.0 = creative)
# Lower values make the agent more consistent, higher values more creative.
# Omit or leave blank to use the default (0.7).
BEDROCK_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Serper.dev — Google Search API
# -----------------------------------------------------------------------------
#
# Serper.dev provides a fast, cheap Google Search API used by SerperDevTool.
# The CrewAI agent uses this to search for the latest AI/LLM news.
#
# Free tier: 2,500 queries/month — no credit card required!
# Sign up at: https://serper.dev
#
# After signing up, find your API key at: https://serper.dev/api-key
#
SERPER_API_KEY=your_serper_api_key_here

# -----------------------------------------------------------------------------
# Output Configuration
# -----------------------------------------------------------------------------
#
# Path where the final Markdown report will be saved.
# Relative to the project root. The `output/` directory is created automatically.
#
OUTPUT_FILE=output/ai_news_summary.md
